FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MBA_DATA_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:5000
PREFERRED_URL_SCHEME=http

# Main MBA application database.
# Use either a PostgreSQL URL or a local SQLite URL such as:
# DATABASE_URL=sqlite:///C:/path/to/Integrated_Ethics_and_MBA/app.db
DATABASE_URL=postgresql+psycopg://postgres:Malvapudding78*@localhost:5432/mba_ethics

# Mounted ethics application database.
# Point this to the same Postgres database when you want the full system on PostgreSQL.
# ETHICS_DATABASE_URL=sqlite:///C:/path/to/Integrated_Ethics_and_MBA/app/ethics_production_app/ethics.db
ETHICS_DATABASE_URL=postgresql+psycopg://postgres:Malvapudding78*@localhost:5432/mba_ethics

# Optional path to Chrome/Chromium for HTML-matching PDF downloads.
# Without a browser renderer, generated HTML forms download as Word .docx files.
# Leave blank locally if Chrome or Edge is installed in a standard location.
MBA_PDF_BROWSER_PATH=

# Optional Microsoft Entra ID login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# SMTP mail delivery. Required for assessor/supervisor onboarding and invitations.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=20
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_LOGO_URL=

# Optional shorthand used by config.py when MAIL_USERNAME/MAIL_PASSWORD are blank.
EMAIL=
EMAIL_CODE=
